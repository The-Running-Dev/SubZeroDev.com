{
  "name": "subzerodev-com",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The SubZeroDev.com apex site.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check-links": "vitest run --config vitest.link-check.config.ts",
    "build": "subzerodev-platform-ui-landing-page build",
    "preview": "node tools/preview.mjs",
    "image-gate": "vitest run --config vitest.image-gate.config.ts",
    "attestation-gate": "vitest run --config vitest.attestation.config.ts",
    "deployment-candidate-gate": "vitest run --config vitest.publish.config.ts tests/publish/deployment-candidate.test.ts",
    "publish-gate": "vitest run --config vitest.publish.config.ts tests/publish/read-back.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "playwright": "^1.62.1",
    "subzerodev-platform-ui-landing-page": "0.3.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10"
  }
}
